# Copy to .env.local. Obtain LOCAL values from `npx supabase status`.
# These examples are not working credentials. Never use a service-role/secret key here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key

# Optional: native database execution of the security suite. LOCAL databases only.
# CODEEDGE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local seed only: scripts/seed-local.mjs reads keys directly from Supabase CLI.
# Website chat requires a SERVER-ONLY database connection. Never prefix NEXT_PUBLIC_.
# Disposable local testing only (native CI supplies this automatically):
# CHAT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted environments must use a dedicated login granted ONLY codeedge_chat_api,
# with sslmode=verify-full. Never use a production owner/service-role credential.

# WhatsApp Cloud API — server-only production integration. Leave unset until a
# provider account/number has been verified and mapped by an operator.
# Never prefix these with NEXT_PUBLIC_ and never commit real values.
# WHATSAPP_DATABASE_URL=postgresql://dedicated-whatsapp-login:secret@db.example.test:5432/postgres?sslmode=verify-full
# WHATSAPP_VERIFY_TOKEN=replace-with-random-webhook-verification-token
# WHATSAPP_APP_SECRET=replace-with-provider-app-secret
# WHATSAPP_ACCESS_TOKEN=replace-with-provider-system-user-token
# WHATSAPP_GRAPH_VERSION=vXX.X


# Internal operator Auth administration ONLY. Server-side secret; never NEXT_PUBLIC_.
# Required only for the AAL2-protected operator invitation/provisioning actions.
# Customer request paths and tenant authorization must never use this credential.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-hosted-secret-or-local-service-role-key

# Copy to .env.local. Obtain LOCAL values from `npx supabase status`.
# These examples are not working credentials. Never use a service-role/secret key here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key

# Optional: native database execution of the security suite. LOCAL databases only.
# CODEEDGE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local seed only: scripts/seed-local.mjs reads keys directly from Supabase CLI.
# Website chat requires a SERVER-ONLY database connection. Never prefix NEXT_PUBLIC_.
# Disposable local testing only (native CI supplies this automatically):
# CHAT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted environments must use a dedicated login granted ONLY codeedge_chat_api,
# with sslmode=verify-full. Never use a production owner/service-role credential.
